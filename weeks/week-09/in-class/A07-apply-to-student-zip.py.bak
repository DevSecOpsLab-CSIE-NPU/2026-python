# A07. 綜合應用：把 I/O 技巧套到真實學生資料
# Bloom: Apply — 複習並組合 R01~A06 的 API
#
# 資料來源：assets/npu-stu-109-114-anon.zip（6 屆新生資料庫，學號已匿名）
# 用到的小節對照：
#   5.11 pathlib 組路徑
#   5.12 exists 檢查
#   5.7  zipfile 讀壓縮檔（不解壓）
#   5.1  encoding='utf-8-sig' 處理 Excel 存的 BOM
#   5.6  io.StringIO 把 bytes 轉成 csv 可讀的 file-like
#   5.19 TemporaryDirectory 沙箱輸出
#   5.5  open(..., 'x') 只寫一次的報告檔
#   5.21 pickle 保存跨屆統計快照
#   5.2  print(file=) 寫 Markdown 週報

# 【導入模組】
import csv              # CSV 表格讀寫
import io               # StringIO：把字串當檔案用
import pickle           # 序列化物件（save/load 複雜資料結構）
import tempfile         # 建立暫存資料夾（沙箱環境）
import zipfile          # 不解壓直接讀 zip 檔
from collections import Counter  # 計數統計工具（替代字典計數）
from pathlib import Path         # 跨平台路徑物件（取代 os.path）

# ── 5.11 / 5.12 找到資料檔 ─────────────────────────────
# 【相對路徑定位】
HERE = Path(__file__).resolve().parent  # 當前 .py 檔所在資料夾的絕對路徑
# 從當前檔往上 3 層 (week-09 → weeks → 2026-python → root)
# 再進 assets 資料夾找 zip 檔
ZIP_PATH = HERE.parent.parent.parent / "assets" / "npu-stu-109-114-anon.zip"
# 【防守性檢查】檔案不存在就立即拋錯，比到真正讀檔時才發現好
assert ZIP_PATH.exists(), f"找不到資料：{ZIP_PATH}"
print("資料來源:", ZIP_PATH.name)


# ── 5.7 + 5.6 + 5.1 不解壓讀 zip 裡的 CSV ──────────────
# 【產生器函數】不同於一次性讀檔，而是逐年逐個檔案 yield 資料
def iter_year_csv(zip_path: Path):
    """【功能】逐年從 zip 中讀出 CSV 資料。
    
    【參數】zip_path: zip 檔的 Path 物件
    【返回】每次 yield (年度字串, CSV header 列表, 資料列表)
    
    【為什麼用 yield？】
      - 不用一次載入全部 6 屆資料到記憶體（節省 RAM）
      - 邊讀邊處理：呼叫者迭代時就能同時計算統計
      - 適合大檔案：避免一次性 memory spike
    
    【為什麼不解壓？】
      - 節省硬碟空間：不用臨時解壓到磁碟
      - 更快：直接在 zip 串流中讀，跳過解壓階段
    """
    # 【with 陳述】自動開關檔案
    # zipfile.ZipFile(zip_path) 打開 zip，執行完自動 close
    with zipfile.ZipFile(zip_path) as z:
        # 【infolist()】取得 zip 內所有檔案的中繼資料 (不讀內容)
        for info in z.infolist():
            # 【檔名檢查】防守：舊的 zip 檔常見中文檔名編碼問題（cp437 亂碼）
            # 這份新生資料庫已預先清理，所以檔名是正確的 utf-8 格式
            name = info.filename
            
            # 【篩選 CSV】只處理 .csv 檔，跳過其他檔案類型
            if not name.endswith(".csv"):
                continue
            
            # 【提取年度】檔名格式通常是 "109年新生資料庫.csv"
            # [:3] 截取前 3 字元即是年度（"109"、"110" ... "114"）
            year = name[:3]

            # ╔════════════════════════════════════════════════════╗
            # ║ 【三步驟轉換】bytes → UTF-8 文字 → CSV 表格解析   ║
            # ╚════════════════════════════════════════════════════╝
            
            # 【第1步】zip.read(info) 讀取檔案原始內容
            # 返回值是 bytes（二進制資料，還未解碼）
            raw = z.read(info)
            
            # 【第2步】raw.decode(\"utf-8-sig\") 把位元組解碼成文字
            # 為什麼用 utf-8-sig 而非 utf-8？
            #   - Excel 存 CSV 時會在檔案開頭加 BOM 標記 (Byte Order Mark)
            #   - BOM = 3 個位元組：0xEF 0xBB 0xBF
            #   - utf-8 不會自動移除，導致第一欄前面有隱形符號
            #   - utf-8-sig 能自動偵測並移除 BOM（推薦用）\n            text = raw.decode(\"utf-8-sig\")\n            \n            # 【第3步】io.StringIO 把字串包成 file-like 物件\n            # 為什麼需要 StringIO？\n            #   - csv.reader(f) 期望 f 是檔案物件（有 readline() 方法）\n            #   - 純字串沒有這些方法，csv.reader 會拒絕\n            #   - StringIO 製造一個「假檔案」，提供檔案介面\n            #   - 這樣 csv.reader 就能逐行讀字串\n            reader = csv.reader(io.StringIO(text))\n            \n            # 【list(reader)】一次讀完所有列\n            # rows[0] = 表頭 (column names)\n            # rows[1:] = 資料列 (student records)\n            rows = list(reader)\n            \n            # ╔════════════════════════════════════════════════════╗\n            # ║ 【yield 而非 return】讓呼叫者邊迭代邊處理          ║\n            # ║ 好處：每次只在記憶體保留 1 屆資料                 ║\n            # ╚════════════════════════════════════════════════════╝\n            yield year, rows[0], rows[1:]


# ── 跨屆統計 ───────────────────────────────────────────
# 【資料結構】summary 存放每屆的統計數據
# 格式: {年度字串: {'total': int, 'by_dept': Counter, 'by_entry': Counter}}
summary = {}
all_depts = Counter()  # 累計 6 屆所有系所的人數分布

for year, header, rows in iter_year_csv(ZIP_PATH):  # 迭代每屆的資料
    # 【動態尋找欄位】不硬編號碼，而是用欄位名稱查位置
    # 好處：若 CSV 欄序改變仍能正確對應，程式邏輯不受影響
    # 壞處：若欄位名稱改變會拋出 ValueError，需事先確認欄位名稱
    dept_idx  = header.index("系所名稱")  # 在 header 列表中找「系所名稱」的位置
    entry_idx = header.index("入學方式")  # 在 header 列表中找「入學方式」的位置

    # ╔════════════════════════════════════════════════════╗
    # ║ 【Counter 統計】用生成器表達式高效過濾+計數        ║
    # ║ 條件 len(r) > idx 的用途：                        ║
    # ║   某些列可能欄位數不足（資料損壞或缺少值）      ║
    # ║   直接存取 r[idx] 會拋 IndexError                ║
    # ║   預先檢查長度能防止程式崩潰                     ║
    # ╚════════════════════════════════════════════════════╝
    
    # 統計各系所人數
    # Counter 把列表轉成 {項目: 出現次數} 的字典
    # 例如：Counter(["資工", "資工", "電子"]) → {"資工": 2, "電子": 1}
    by_dept  = Counter(r[dept_idx]  for r in rows if len(r) > dept_idx)
    
    # 統計各入學方式人數
    # 入學方式可能包括：推甄、指考、繁星、運動、原民等
    by_entry = Counter(r[entry_idx] for r in rows if len(r) > entry_idx)

    # 【存入主字典】按年度分類組織統計結果
    summary[year] = {
        "total":    len(rows),      # 該屆新生總人數 = 資料列的個數
        "by_dept":  by_dept,        # Counter 物件：{系所名: 人數, ...}
        "by_entry": by_entry,       # Counter 物件：{入學方式: 人數, ...}
    }
    
    # 【跨屆累計】把本屆的系所統計融合到全體 all_depts
    # Counter.update(other_counter) 會加總相同 key 的計數
    # 例如：
    #   all_depts 已有 {"資工": 200}
    #   本屆 by_dept 有 {"資工": 180}
    #   update 後 all_depts["資工"] = 200 + 180 = 380
    all_depts.update(by_dept)

# ── 終端輸出：總覽 ──────────────────────────────────────
# ╔════════════════════════════════════════════════════╗
# ║ 【第一組統計】各屆新生人數總覽                    ║
# ╚════════════════════════════════════════════════════╝
print("\n=== 6 屆新生人數 ===")
# 【sorted()】確保按年度升序輸出
# 年份字串（"109", "110", ...）的字典序恰好等於年度升序
for year in sorted(summary):
    # 【格式化】:>4 = 右對齐、寬度 4 個字元
    # 好處：數字對齐，看起來整齊
    total = summary[year]['total']
    print(f"  {year} 學年：{total:>4} 人")

# ╔════════════════════════════════════════════════════╗
# ║ 【第二組統計】歷年最熱門 5 大系所（跨屆累計）   ║
# ╚════════════════════════════════════════════════════╝
print("\n=== 全體最熱門 5 個系所（累計 6 屆） ===")
# 【Counter.most_common(n)】
# 回傳前 n 個最常見項目，順序為降序（最多在前）
# 回傳格式：[(item, count), (item, count), ...]
for dept, n in all_depts.most_common(5):
    print(f"  {n:>4} 人  {dept}")

# ╔════════════════════════════════════════════════════╗
# ║ 【第三組統計】114 年度（最新一屆）入學方式分布   ║
# ╚════════════════════════════════════════════════════╝
print("\n=== 114 學年入學方式分布 ===")
# 【單層存取】summary["114"] 取 114 年的統計結果（字典）
#            再取 ["by_entry"] = Counter 物件
# 若沒有 114 年會拋 KeyError，需事先檢查
for kind, n in summary["114"]["by_entry"].most_common():
    print(f"  {n:>4} 人  {kind}")


# ── 5.19 + 5.5 + 5.2 沙箱產生報告、5.21 存快照 ─────────
with tempfile.TemporaryDirectory() as tmp:
    # 【型別轉換】str → Path，才能用 / 組路徑
    tmp = Path(tmp)
    print(f"沙箱位置：{tmp}")

    # ╔════════════════════════════════════════════════════╗
    # ║ 【快照保存】用 pickle 序列化複雜物件              ║
    # ║ 為什麼不用 JSON？                                 ║
    # ║   - JSON 只能存基本型別（str, int, list, dict）  ║
    # ║   - Counter 物件無法直接 JSON 序列化            ║
    # ║   - pickle 能存任何 Python 物件，無損還原      ║
    # ╚════════════════════════════════════════════════════╝
    
    # pickle 存檔到沙箱
    snap = tmp / "summary.pkl"
    # 【"wb" 模式】write binary：以位元組形式寫檔
    with open(snap, "wb") as f:
        # pickle.dump(物件, 檔案)：把物件序列化寫入檔案
        pickle.dump(summary, f)
    
    # 驗證序列化大小
    file_size = snap.stat().st_size
    print(f"快照寫入 {snap.name}：{file_size} bytes")

    # ╔════════════════════════════════════════════════════╗
    # ║ 【排他性寫檔】'x' 模式防止意外覆蓋                ║
    # ║ 模式對比：                                        ║
    # ║   'w' = write：存在就覆蓋（危險）              ║
    # ║   'x' = exclusive create：存在就報錯（安全）   ║
    # ║   'a' = append：存在就附加（可能不想要）       ║
    # ╚════════════════════════════════════════════════════╝
    
    report = tmp / "report.md"
    # 【"x" 模式】排他建立：若檔案存在會拋 FileExistsError
    # 【encoding="utf-8"】確保中文正確編碼
    with open(report, "x", encoding="utf-8") as f:
        # 【print(file=f)】改變 print 的目標為檔案而非終端
        # 這是 Python 內建函數的強大功能
        print("# 6 屆新生概況報告", file=f)
        print("", file=f)
        print("| 學年 | 人數 | 第一大系所 |", file=f)
        print("|------|------|------------|", file=f)
        for year in sorted(summary):
            # 【most_common(1)】取最常見的 1 項
            # 回傳 [(item, count)]（含括號）
            # [0] 取第一個元組，(item, count) 自動解包
            top_dept, top_n = summary[year]["by_dept"].most_common(1)[0]
            
            total = summary[year]['total']
            print(f"| {year} | {total} | {top_dept} ({top_n}) |", file=f)

    # ╔════════════════════════════════════════════════════╗
    # ║ 【驗證寫檔】讀回 Markdown 預覽效果                ║
    # ╚════════════════════════════════════════════════════╝
    
    print("\\n=== Markdown 報告預覽 ===")
    # 【Path.read_text(encoding)】一次讀整個檔案成字串
    # 等同於：
    #   with open(report, 'r', encoding='utf-8') as f:
    #       content = f.read()
    print(report.read_text(encoding="utf-8"))

    # ╔════════════════════════════════════════════════════╗
    # ║ 【驗證反序列化】確保 pickle 往返一致性            ║
    # ╚════════════════════════════════════════════════════╝
    
    print("\\n--- pickle 反序列化驗證 ---")
    # 【"rb" 模式】read binary：以位元組形式讀檔
    with open(snap, "rb") as f:
        # pickle.load(檔案)：讀取位元組流並反序列化成 Python 物件
        loaded = pickle.load(f)
    
    # 驗證結構一致性：key 應該是 ["109", "110", ..., "114"]
    print(f"pickle 讀回的年度 key：{sorted(loaded.keys())}")
    
    # 簡易驗證：確認某個年度的統計還原正確
    if "114" in loaded:
        print(f"114 年總人數驗證：{loaded['114']['total']}")
        print(f"114 年最熱門系所：{loaded['114']['by_dept'].most_common(1)}")

# ╔════════════════════════════════════════════════════╗
# ║ 【自動清理】離開 with 區塊時觸發                  ║
# ║ 特性：TemporaryDirectory 會遞迴刪除所有內部檔案  ║
# ║ 優點：不怕遺漏、不污染專案、安全穩定            ║
# ╚════════════════════════════════════════════════════╝
print("\\n(✓ 沙箱已自動清理，report.md 和 summary.pkl 已刪除)")\n\n    # 【驗證 pickle 反序列化】確保序列化/反序列化正常
    # 目的：測試 pickle.dump/load 的往返一致性（型別、內容都對）
    with open(snap, "rb") as f:
        loaded = pickle.load(f)  # 反序列化：bytes → Python 物件
    print(\"pickle 讀回 key:\", sorted(loaded.keys()))\n\n# 【with 區塊結束】離開 TemporaryDirectory 的 with\n# → tmp 資料夾自動刪除（包含內部所有檔案）\n# → 不會在專案目錄留下暫存垃圾\nprint(\"\\n(沙箱已自動清理)\")\n\n\n# ── 課堂延伸挑戰 ── 【進階應用】加深對 I/O 技巧的理解 ────────────────────────\n# \n# 1️⃣  把報告改寫到專案目錄 (HERE / 'report.md')\n#    - 目前用 'x' 模式確保檔案只寫一次\n#    - 改用 'w' 模式會無聲覆蓋（危險）\n#    - 題目：不用沙箱，怎麼在專案目錄安全寫檔？\n#    - 提示：考慮用 pathlib.Path 先 unlink()（若存在）再 write_text()\n#\n# 2️⃣  加一欄「女性比例」到 Markdown 表格\n#    - 找出 CSV 性別欄位（可能叫「性別」、「gender」等）\n#    - 用 Counter 統計該欄：{\"女\": n, \"男\": m}\n#    - 計算百分比：女性人數 / 該屆總人數 × 100\n#\n# 3️⃣  把 summary 壓縮存成 summary.pkl.gz（gzip 節省空間）\n#    - import gzip\n#    - with gzip.open('summary.pkl.gz', 'wb') as f:\n#    -     pickle.dump(summary, f)\n#    - 好處：統計資料量大時節省硬碟 I/O 和存儲空間\n#\n# 4️⃣  跨屆分析「人數逐年下降最明顯的系所」\n#    - 把 by_dept 按年排成折線：{\"系所\": [109→114 人數序列]}\n#    - 計算斜率或下降幅度\n#    - 提示：可用 matplotlib 繪圖或純文字做 trend analysis
#
# 2) 加一欄「女性比例」到 Markdown 表格
#    - CSV 應該有性別欄位，用 Counter 統計「女性人數」
#    - 計算百分比：女性人數 / 該屆總人數
#
# 3) 把 summary 壓縮存成 summary.pkl.gz
#    - import gzip 開啟壓縮檔：gzip.open('summary.pkl.gz', 'wb')
#    - pickle.dump 寫入壓縮流
#    - 好處：節省儲存空間（特別是統計資料多時）
#
# 4) 跨屆分析「人數逐年下降最明顯的系所」
#    - 把 by_dept 按年排成折線圖 (x=年度, y=人數)
#    - 找出下降幅度最大的系所
#    - 提示：可用 matplotlib 畫圖或純文字做 trend analysis
