def simulate_traps(N: int, M: int, proposals: List[Tuple[int, int]]) -> List[str]:
    grid = [[0] * M for _ in range(N)]
    outputs: List[str] = []

    for x, y in proposals:
        if grid[x][y] == 1:
            outputs.append('>_<')
            continue

        grid[x][y] = 1
        if path_exists(grid):
            outputs.append('<(_ _)>')
        else:
            outputs.append('>_<')
            grid[x][y] = 0

    return outputs
