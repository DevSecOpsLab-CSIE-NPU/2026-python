import sys
import math
def gcd_pair_sum(n: int) -> int:
    if n < 2:
        return 0
    return sum(math.gcd(i, j) for i in range(1, n) for j in range(i + 1, n + 1))
    def main() -> None:
    data = sys.stdin.read().strip().split()
    if not data:
        return
    for token in data:
        try:
            n = int(token)
        except ValueError:
            continue
        if n == 0:
            break
        print(gcd_pair_sum(n))
if __name__ == '__main__':
    main()