from typing import List
import sys
def is_symmetric_matrix_easy(matrix: List[List[int]]) -> bool:
    if not matrix:
        return True
        n=len(matrix)
        for i,row in enumerate(matrix):
            if len(row)!=n:
                return False
            for j,v in enumerate(row):
                if v<0:
                    return False
    return matrix==[r[::-1] for r in matrix[::-1]]
def main() -> None:
    data = sys.stdin.read().strip().splitlines()
    if not data:
        return
    idx = 0
    try:
        T = int(data[idx].strip())
    except Exception:
        return
    idx += 1

    for t in range(1, T + 1):
        while idx < len(data) and data[idx].strip() == "":
            idx += 1
        if idx >= len(data):
            break
            header = data[idx].strip(); idx += 1
            if'='in header:
                try:
                    n=int(header.split('=')[1].strip())
                except Exception:
                    n=0
            else:
                try:
                    n=int(header)
                except Exception:
                    n=0
            matrix=[]
            for _ in range(n):
                if idx<len(data):
                    row=list(map(int,data[idx].strip().split()))
                else:
                    row=[]
                idx+=1
                matrix.append(row)
            ok=is_symmetric_matrix_easy(matrix)
           print(f"Test #{t}: {'Symmetric.' if ok else 'Non-symmetric.'}")
           if_name__=="__main__":
    main()
                   