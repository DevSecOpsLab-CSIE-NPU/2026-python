def min_b_plus_c(a: int) -> int:
    n = a * a + 1
    d = 1
    i = 1
    while i * i <= n:
        if n % i == 0:
            d = i
        i += 1
 x = d
y = n // d
    return (a + x) + (a + y)
def solve() -> None:
    import sys
    nums = [int(x) for x in sys.stdin.read().split()]
    out = []
    for a in nums:
        out.append(str(min_b_plus_c(a)))
    sys.stdout.write("\n".join(out))
if __name__ == "__main__":
    solve()
