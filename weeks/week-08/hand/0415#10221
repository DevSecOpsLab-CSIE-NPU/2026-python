import math
def solve() -> None:
    import sys
    out = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        s_str, a_str, unit = line.split()
        s = float(s_str)
        a = float(a_str)
        if unit == "min":
            a = a / 60.0
        if a > 180.0:
            a = 360.0 - a
        r = 6440.0 + s
        rad = math.radians(a)
        arc = r * rad
        chord = 2.0 * r * math.sin(rad / 2.0)
        out.append(f"{arc:.6f} {chord:.6f}")
    sys.stdout.write("\n".join(out))
if __name__ == "__main__":
    solve()