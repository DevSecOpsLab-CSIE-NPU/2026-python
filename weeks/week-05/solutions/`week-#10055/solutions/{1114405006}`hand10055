import sys
class FenwickTree:
    def __init__(self, n: int) -> None:
        self.n = n
        self.bit = [0] * (n + 1)
    def add(self, i: int, delta: int) -> None:
        while i <= self.n:
            self.bit[i] += delta
            i += i & -i
    def prefix_sum(self, i: int) -> int:
        s = 0
        while i > 0:
            s += self.bit[i]
            i -= i & -i
        return s
    def range_sum(self, left: int, right: int) -> int:

        return self.prefix_sum(right) - self.prefix_sum(left - 1)
