import sys
def main() -> None:
    nums = list(map(int, sys.stdin.read().split()))
    if not nums:
        return
    t = nums[0]
    i = 1       
    ans = []
    for _ in range(t):
        r = nums[i]
        i += 1
        a = nums[i : i + r]
        i += r
        a.sort()
        m = a[r // 2]
        ans.append(str(sum(abs(x - m) for x in a))) 
       sys.stdout.write("\n".join(ans) )
if __name__ == "__main__":
    main()

